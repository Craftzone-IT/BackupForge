<Window x:Class="BackupForge.Gui.JobWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BackupForge.Gui"
        Title="{l:Loc w_title}" Height="680" Width="980" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- the steps; a finished step can be clicked to go back -->
        <Border DockPanel.Dock="Left" Background="#f1f3f6" Width="190" Padding="6">
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Step}"
                                HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,1" Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓ " Foreground="#2e7d32" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="! " Foreground="#b00020" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding Title}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- buttons -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#dde" BorderThickness="0,1,0,0" Padding="8,6">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="{l:Loc w_advanced}" Command="{Binding ToggleAdvancedCommand}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:Loc w_back}" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}"/>
                    <Button Content="{l:Loc w_next}" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" IsDefault="True"
                            Visibility="{Binding IsLastStep, Converter={x:Static l:Converters.InverseBoolToVis}}"/>
                    <Button Content="{l:Loc l_dryrun}" Command="{Binding DryRunCommand}" Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{l:Loc w_finish}" Command="{Binding FinishCommand}" IsEnabled="{Binding CanFinish}" FontWeight="Bold"
                            Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{l:Loc w_finish_run}" Command="{Binding FinishAndRunCommand}" IsEnabled="{Binding CanFinish}"
                            Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{l:Loc w_cancel}" IsCancel="True"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="12,10,12,0">
            <TextBlock Text="{Binding StepTitle}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding CurrentError}" Style="{StaticResource Error}" Visibility="{Binding CurrentError, Converter={x:Static l:Converters.NotNullToVisible}}"/>
        </StackPanel>

        <Grid Margin="12,4,12,8">
            <!-- Speciális: every field with a human label (also the full field list when editing) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVis}}" DataContext="{Binding Draft}">
                <StackPanel>
                    <TextBlock Text="{l:Loc w_advanced_help}" Style="{StaticResource Help}"/>
                    <GroupBox Header="{l:Loc w_adv_general}">
                        <UniformGrid Columns="2">
                            <Label Content="{l:Loc w_id}"/><TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" ToolTip="id"/>
                            <Label Content="{l:Loc w_expected_interval}"/><TextBox Text="{Binding ExpectedIntervalH, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Loc w_expected_interval_help}"/>
                            <CheckBox Content="{l:Loc w_catch_up}" IsChecked="{Binding CatchUp}" ToolTip="{l:Loc w_catch_up_help}"/><Label/>
                        </UniformGrid>
                    </GroupBox>
                    <GroupBox Header="{l:Loc type_files}" Visibility="{Binding IsFiles, Converter={StaticResource BoolToVis}}">
                        <UniformGrid Columns="2">
                            <CheckBox Content="{l:Loc w_compare_content}" IsChecked="{Binding ContentCompare}" ToolTip="{l:Loc w_compare_help}"/><Label/>
                            <Label Content="{l:Loc w_versions_folder}"/><TextBox Text="{Binding VersionsFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Hint}" Tag="{l:Loc w_versions_folder_hint}"/>
                            <Label Content="{l:Loc w_guard_pct}"/><TextBox Text="{Binding GuardPct, UpdateSourceTrigger=PropertyChanged}" ToolTip="delete_guard_pct"/>
                            <Label Content="{l:Loc w_guard_min}"/><TextBox Text="{Binding GuardMin, UpdateSourceTrigger=PropertyChanged}" ToolTip="delete_guard_min_files"/>
                            <Label Content="{l:Loc w_vss}"/><ComboBox ItemsSource="{x:Static l:Lists.Vss}" SelectedValuePath="Id" DisplayMemberPath="Text" SelectedValue="{Binding FilesVss}"/>
                        </UniformGrid>
                    </GroupBox>
                    <GroupBox Header="{l:Loc type_restic}" Visibility="{Binding IsRestic, Converter={StaticResource BoolToVis}}">
                        <UniformGrid Columns="2">
                            <Label Content="{l:Loc w_vss}"/><ComboBox ItemsSource="{x:Static l:Lists.Vss}" SelectedValuePath="Id" DisplayMemberPath="Text" SelectedValue="{Binding ResticVss}"/>
                            <Label Content="{l:Loc w_tags}"/><TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Loc w_tags_help}"/>
                        </UniformGrid>
                    </GroupBox>
                    <GroupBox Header="{l:Loc type_sql}" Visibility="{Binding IsSql, Converter={StaticResource BoolToVis}}">
                        <UniformGrid Columns="2">
                            <CheckBox Content="{l:Loc w_copy_only}" IsChecked="{Binding CopyOnly}" ToolTip="{l:Loc w_copy_only_help}"/><Label/>
                            <Label Content="{l:Loc w_compression}"/><ComboBox ItemsSource="{x:Static l:Lists.Compression}" SelectedValuePath="Id" DisplayMemberPath="Text" SelectedValue="{Binding Compression}"/>
                            <Label Content="{l:Loc w_exclude_dbs}"/><TextBox Text="{Binding SqlExclude, UpdateSourceTrigger=PropertyChanged}"/>
                        </UniformGrid>
                    </GroupBox>
                    <TextBlock Text="{Binding Errors}" Style="{StaticResource Error}"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowAdvanced, Converter={x:Static l:Converters.InverseBoolToVis}}">
                <Grid>
                    <!-- 1. type -->
                    <StackPanel Visibility="{Binding Current, Converter={x:Static l:Converters.StepIs}, ConverterParameter=Type}">
                        <Button Command="{Binding SelectTypeCommand}" CommandParameter="files" HorizontalContentAlignment="Left" Padding="12" Margin="0,4">
                            <StackPanel><TextBlock Text="{l:Loc type_files}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{l:Loc w_type_files_help}" Style="{StaticResource Help}"/></StackPanel>
                        </Button>
                        <Button Command="{Binding SelectTypeCommand}" CommandParameter="restic" HorizontalContentAlignment="Left" Padding="12" Margin="0,4">
                            <StackPanel><TextBlock Text="{l:Loc type_restic}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{l:Loc w_type_restic_help}" Style="{StaticResource Help}"/></StackPanel>
                        </Button>
                        <Button Command="{Binding SelectTypeCommand}" CommandParameter="sql" HorizontalContentAlignment="Left" Padding="12" Margin="0,4">
                            <StackPanel><TextBlock Text="{l:Loc type_sql}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{l:Loc w_type_sql_help}" Style="{StaticResource Help}"/></StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 2a. source (files, restic) -->
                    <StackPanel Visibility="{Binding Current, Converter={x:Static l:Converters.StepIs}, ConverterParameter=Source}">
                        <StackPanel Visibility="{Binding IsRestic, Converter={StaticResource BoolToVis}}">
                            <RadioButton Content="{l:Loc w_source_folders}" IsChecked="{Binding UseStagingSource, Converter={x:Static l:Converters.Not}}" Margin="2,4"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{l:Loc w_source_sql}" IsChecked="{Binding UseStagingSource}" Margin="2,4" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding SqlJobChoices}" SelectedValuePath="Id" DisplayMemberPath="Text" SelectedValue="{Binding StagingJobId}" MinWidth="220"
                                          IsEnabled="{Binding UseStagingSource}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding UseStagingSource, Converter={x:Static l:Converters.InverseBoolToVis}}">
                            <TextBlock Text="{l:Loc w_source_help}" Style="{StaticResource Help}"/>
                            <ItemsControl ItemsSource="{Binding SourceRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#dde" BorderThickness="1" Padding="6" Margin="0,3">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="{l:Loc l_remove}" Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                                                </DockPanel>
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding Warning, Converter={x:Static l:Converters.NotNullToVisible}}">
                                                    <TextBlock Text="{Binding Warning}" Style="{StaticResource WarningText}" MaxWidth="560"/>
                                                    <Button Content="{l:Loc w_use_unc}" Command="{Binding DataContext.UseUncCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding SuggestedUnc, Converter={x:Static l:Converters.NotNullToVisible}}"/>
                                                </StackPanel>
                                                <Label Content="{l:Loc w_excludes}"/>
                                                <TextBox Text="{Binding Excludes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Hint}" Tag="*.tmp; ~$*; \$RECYCLE.BIN\"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{l:Loc w_add_folder}" Command="{Binding AddSourceCommand}"/>
                                <Button Content="{l:Loc w_check_sources}" Command="{Binding CheckSourcesCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{l:Loc w_default_excludes}" Style="{StaticResource Help}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 2b. target (files) -->
                    <StackPanel Visibility="{Binding Current, Converter={x:Static l:Converters.StepIs}, ConverterParameter=Target}">
                        <Label Content="{l:Loc w_target}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding TargetChoices}" SelectedValuePath="Id" DisplayMemberPath="Text" SelectedValue="{Binding Draft.TargetId}" MinWidth="420"/>
                            <Button Content="{l:Loc w_new_target}" Command="{Binding NewTargetCommand}"/>
                        </StackPanel>
                        <Label Content="{l:Loc w_subdir}"/>
                        <TextBox Text="{Binding Draft.Subdir, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource Help}" Margin="2,8,2,0"><Run Text="{l:Loc w_mirror_path}"/> <Run Text="{Binding MirrorPreview, Mode=OneWay}" FontFamily="Consolas"/></TextBlock>
                        <TextBlock Style="{StaticResource Help}"><Run Text="{l:Loc w_versions_path}"/> <Run Text="{Binding VersionsPreview, Mode=OneWay}" FontFamily="Consolas"/></TextBlock>
                        <ItemsControl ItemsSource="{Binding TargetProblems}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" Style="{StaticResource Error}"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 2c. mode and retention (files) -->
                    <StackPanel Visibility="{Binding Current, Converter={x:Static l:Converters.StepIs}, ConverterParameter=Mode}">
                        <RadioButton Content="{l:Loc w_mode_mirror}" IsChecked="{Binding IsMirror}" Margin="2,4"/>
                        <RadioButton Content="{l:Loc w_mode_update}" IsChecked="{Binding IsUpdate}" Margin="2,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox Content="{l:Loc w_keep_versions}" IsChecked="{Binding Draft.Versioning}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Draft.KeepDays, UpdateSourceTrigger=PropertyChanged}" MinWidth="50" Width="50"/>
                            <TextBlock Text="{l:Loc w_days}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding GuardSentence}" Style="{StaticResource Help}" Margin="2,8,2,0"/>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{l:Loc w_guard_pct}"/><TextBox Text="{Binding Draft.GuardPct, UpdateSourceTrigger=PropertyChanged}" MinWidth="50" Width="50"/>
                            <Label Content="{l:Loc w_guard_min}"/><TextBox Text="{Binding Draft.GuardMin, UpdateSourceTrigger=PropertyChanged}" MinWidth="60" Width="60"/>
                        </StackPanel>
                        <Label Content="{l:Loc w_vss_question}" Margin="0,8,0,0"/>
                        <ComboBox ItemsSource="{x:Static l:Lists.Vss}" SelectedValuePath="Id" DisplayMemberPath="Text" SelectedValue="{Binding Draft.FilesVss}" Width="320" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- 2d. repository (restic) -->
                    <StackPanel Visibility="{Binding Current, Converter={x:Static l:Converters.StepIs}, ConverterParameter=Repo}">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding RepoChoices}" SelectedValuePath="Id" DisplayMemberPath="Text" SelectedValue="{Binding Draft.RepoId}" MinWidth="420"/>
                            <Button Content="{l:Loc w_new_repo}" Command="{Binding CreateRepoCommand}"/>
                            <Button Content="{l:Loc w_check_repo}" Command="{Binding CheckRepoCommand}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Help}" Margin="2,8,2,0"><Run Text="{l:Loc w_retention}"/> <Run Text="{Binding RetentionSummary, Mode=OneWay}"/></TextBlock>
                        <TextBlock Text="{l:Loc w_retention_help}" Style="{StaticResource Help}"/>
                        <Border Background="#fff4d6" Padding="8" Visibility="{Binding RepoNotInitialized, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc w_repo_not_initialized}" TextWrapping="Wrap"/>
                                <Button Content="{l:Loc w_create_repo_now}" Command="{Binding CreateRepoCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2e. SQL instance -->
                    <StackPanel Visibility="{Binding Current, Converter={x:Static l:Converters.StepIs}, ConverterParameter=Instance}">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding InstanceChoices}" SelectedValuePath="Id" DisplayMemberPath="Text" Text="{Binding Draft.SqlInstance, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" MinWidth="360"/>
                            <Button Content="{l:Loc l_discover}" Command="{Binding DiscoverCommand}"/>
                        </StackPanel>
                        <RadioButton Content="{l:Loc w_auth_windows}" IsChecked="{Binding Draft.SqlAuthSql, Converter={x:Static l:Converters.Not}}" Margin="2,8,2,2"/>
                        <RadioButton Content="{l:Loc w_auth_sql}" IsChecked="{Binding Draft.SqlAuthSql}" Margin="2"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Draft.SqlAuthSql, Converter={StaticResource BoolToVis}}">
                            <Label Content="{l:Loc w_sql_user}"/><TextBox Text="{Binding Draft.SqlUsername, UpdateSourceTrigger=PropertyChanged}"/>
                            <Label Content="{l:Loc l_password}"/><PasswordBox x:Name="SqlPw" Width="160" PasswordChanged="SqlPasswordChanged"/>
                        </StackPanel>
                        <Border Background="#fff4d6" Padding="8" Margin="0,8,0,0" Visibility="{Binding PermissionProblem, Converter={x:Static l:Converters.NotNullToVisible}}">
                            <TextBlock Text="{Binding PermissionProblem}" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="{l:Loc w_grant_help}" Style="{StaticResource Help}" Margin="2,8,2,0"/>
                        <Button Content="{l:Loc w_grant}" Command="{Binding GrantCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- 2f. databases -->
                    <StackPanel Visibility="{Binding Current, Converter={x:Static l:Converters.StepIs}, ConverterParameter=Databases}">
                        <RadioButton Content="{l:Loc w_all_user_dbs}" IsChecked="{Binding AllUserDatabases}" Margin="2,4"/>
                        <RadioButton Content="{l:Loc w_selected_dbs}" IsChecked="{Binding SelectedDatabases}" Margin="2,4"/>
                        <CheckBox Content="{l:Loc w_include_system}" IsChecked="{Binding Draft.IncludeSystem}"/>
                        <Button Content="{l:Loc l_discover}" Command="{Binding DiscoverCommand}" HorizontalAlignment="Left"/>
                        <DataGrid ItemsSource="{Binding DbRows}" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="300" IsEnabled="{Binding SelectedDatabases}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="{l:Loc w_db_name}" Binding="{Binding Name}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{l:Loc w_db_recovery}" Binding="{Binding Recovery}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{l:Loc w_db_size}" Binding="{Binding Size}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="" Binding="{Binding Warning}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <!-- 2g. SQL options -->
                    <StackPanel Visibility="{Binding Current, Converter={x:Static l:Converters.StepIs}, ConverterParameter=SqlOptions}">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{l:Loc w_keep_local}"/><TextBox Text="{Binding Draft.KeepLocal, UpdateSourceTrigger=PropertyChanged}" MinWidth="50" Width="50"/>
                        </StackPanel>
                        <CheckBox Content="{l:Loc w_verify}" IsChecked="{Binding Draft.Verify}"/>
                        <CheckBox Content="{l:Loc w_checkdb_weekly}" IsChecked="{Binding CheckdbWeekly}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox Content="{l:Loc w_also_to_repo}" IsChecked="{Binding AlsoToRepo}" VerticalAlignment="Center" IsEnabled="{Binding IsNew}"/>
                            <ComboBox ItemsSource="{Binding RepoChoices}" SelectedValuePath="Id" DisplayMemberPath="Text" SelectedValue="{Binding AlsoRepoId}" MinWidth="260" IsEnabled="{Binding AlsoToRepo}"/>
                        </StackPanel>
                        <TextBlock Text="{l:Loc w_also_to_repo_help}" Style="{StaticResource Help}"/>
                    </StackPanel>

                    <!-- 3. schedule -->
                    <StackPanel Visibility="{Binding Current, Converter={x:Static l:Converters.StepIs}, ConverterParameter=Schedule}">
                        <RadioButton Content="{l:Loc w_sched_interval}" IsChecked="{Binding ScheduleKindChoice, Converter={x:Static l:Converters.EqualsParam}, ConverterParameter=interval}" Margin="2,3"/>
                        <StackPanel Orientation="Horizontal" Margin="22,0,0,0" Visibility="{Binding ScheduleKindChoice, Converter={x:Static l:Converters.EqualsToVis}, ConverterParameter=interval}">
                            <Label Content="{l:Loc w_every_hours}"/><TextBox Text="{Binding EveryHours, UpdateSourceTrigger=PropertyChanged}" MinWidth="40" Width="40"/>
                            <Label Content="{l:Loc w_start}"/><TextBox Text="{Binding Draft.Start, UpdateSourceTrigger=PropertyChanged}" MinWidth="60" Width="60" Style="{StaticResource Hint}" Tag="06:00"/>
                            <Label Content="{l:Loc w_window}"/><TextBox Text="{Binding Draft.WindowFrom, UpdateSourceTrigger=PropertyChanged}" MinWidth="60" Width="60" Style="{StaticResource Hint}" Tag="07:00"/>
                            <TextBlock Text="–" VerticalAlignment="Center"/><TextBox Text="{Binding Draft.WindowTo, UpdateSourceTrigger=PropertyChanged}" MinWidth="60" Width="60" Style="{StaticResource Hint}" Tag="19:00"/>
                        </StackPanel>
                        <RadioButton Content="{l:Loc w_sched_daily}" IsChecked="{Binding ScheduleKindChoice, Converter={x:Static l:Converters.EqualsParam}, ConverterParameter=daily}" Margin="2,3"/>
                        <StackPanel Margin="22,0,0,0" Visibility="{Binding ScheduleKindChoice, Converter={x:Static l:Converters.EqualsToVis}, ConverterParameter=daily}">
                            <StackPanel Orientation="Horizontal"><Label Content="{l:Loc w_times}"/><TextBox Text="{Binding Draft.Times, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Hint}" Tag="12:30, 22:30"/></StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="{l:Loc d_mon}" IsChecked="{Binding DayFlags[0], Mode=OneWay}" Command="{Binding ToggleDayCommand}" CommandParameter="Mon"/>
                                <CheckBox Content="{l:Loc d_tue}" IsChecked="{Binding DayFlags[1], Mode=OneWay}" Command="{Binding ToggleDayCommand}" CommandParameter="Tue"/>
                                <CheckBox Content="{l:Loc d_wed}" IsChecked="{Binding DayFlags[2], Mode=OneWay}" Command="{Binding ToggleDayCommand}" CommandParameter="Wed"/>
                                <CheckBox Content="{l:Loc d_thu}" IsChecked="{Binding DayFlags[3], Mode=OneWay}" Command="{Binding ToggleDayCommand}" CommandParameter="Thu"/>
                                <CheckBox Content="{l:Loc d_fri}" IsChecked="{Binding DayFlags[4], Mode=OneWay}" Command="{Binding ToggleDayCommand}" CommandParameter="Fri"/>
                                <CheckBox Content="{l:Loc d_sat}" IsChecked="{Binding DayFlags[5], Mode=OneWay}" Command="{Binding ToggleDayCommand}" CommandParameter="Sat"/>
                                <CheckBox Content="{l:Loc d_sun}" IsChecked="{Binding DayFlags[6], Mode=OneWay}" Command="{Binding ToggleDayCommand}" CommandParameter="Sun"/>
                            </StackPanel>
                        </StackPanel>
                        <RadioButton Content="{l:Loc w_sched_weekly}" IsChecked="{Binding ScheduleKindChoice, Converter={x:Static l:Converters.EqualsParam}, ConverterParameter=weekly}" Margin="2,3"/>
                        <StackPanel Orientation="Horizontal" Margin="22,0,0,0" Visibility="{Binding ScheduleKindChoice, Converter={x:Static l:Converters.EqualsToVis}, ConverterParameter=weekly}">
                            <ComboBox ItemsSource="{x:Static l:Lists.Days}" SelectedValuePath="Id" DisplayMemberPath="Text" SelectedValue="{Binding Draft.Day}"/>
                            <TextBox Text="{Binding Draft.Time, UpdateSourceTrigger=PropertyChanged}" MinWidth="60" Width="60"/>
                        </StackPanel>
                        <RadioButton Content="{l:Loc w_sched_monthly}" IsChecked="{Binding ScheduleKindChoice, Converter={x:Static l:Converters.EqualsParam}, ConverterParameter=monthly}" Margin="2,3"/>
                        <StackPanel Orientation="Horizontal" Margin="22,0,0,0" Visibility="{Binding ScheduleKindChoice, Converter={x:Static l:Converters.EqualsToVis}, ConverterParameter=monthly}">
                            <ComboBox ItemsSource="{x:Static l:Lists.MonthDays}" SelectedValuePath="Id" DisplayMemberPath="Text" SelectedValue="{Binding Draft.DayOfMonth}"/>
                            <TextBox Text="{Binding Draft.Time, UpdateSourceTrigger=PropertyChanged}" MinWidth="60" Width="60"/>
                        </StackPanel>
                        <RadioButton Content="{l:Loc w_sched_chained}" IsChecked="{Binding ScheduleKindChoice, Converter={x:Static l:Converters.EqualsParam}, ConverterParameter=chained}" Margin="2,3"/>
                        <ComboBox Margin="22,0,0,0" HorizontalAlignment="Left" MinWidth="320" ItemsSource="{Binding ChainChoices}" SelectedValuePath="Id" DisplayMemberPath="Text" SelectedValue="{Binding ChainParentId}"
                                  Visibility="{Binding ScheduleKindChoice, Converter={x:Static l:Converters.EqualsToVis}, ConverterParameter=chained}"/>
                        <RadioButton Content="{l:Loc w_sched_manual}" IsChecked="{Binding ScheduleKindChoice, Converter={x:Static l:Converters.EqualsParam}, ConverterParameter=manual}" Margin="2,3"/>
                        <TextBlock Text="{Binding SchedulePreview}" FontStyle="Italic" FontSize="14" Margin="2,10,2,2"/>
                        <TextBlock Text="{l:Loc w_next_runs}" Margin="2,6,2,0" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding NextRuns}" Margin="10,0"/>
                        <TextBlock Text="{Binding ExpectedIntervalText}" Style="{StaticResource Help}" Margin="2,6,2,0"/>
                    </StackPanel>

                    <!-- 4. name -->
                    <StackPanel Visibility="{Binding Current, Converter={x:Static l:Converters.StepIs}, ConverterParameter=Name}">
                        <Label Content="{l:Loc w_name}"/>
                        <TextBox Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource Help}"><Run Text="{l:Loc w_id}"/>: <Run Text="{Binding Draft.Id, Mode=OneWay}" FontFamily="Consolas"/> — <Run Text="{l:Loc w_id_help}"/></TextBlock>
                        <TextBlock Text="{l:Loc w_id_change_warning}" Style="{StaticResource WarningText}" Visibility="{Binding IdChangeWarning, Converter={StaticResource BoolToVis}}"/>
                        <CheckBox Content="{l:Loc l_enabled}" IsChecked="{Binding Draft.Enabled}"/>
                    </StackPanel>

                    <!-- 5. summary -->
                    <StackPanel Visibility="{Binding Current, Converter={x:Static l:Converters.StepIs}, ConverterParameter=Summary}">
                        <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" FontSize="14" Margin="2,4,2,8"/>
                        <ItemsControl ItemsSource="{Binding Problems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenProblemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="2" Cursor="Hand">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#b00020"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter Property="Foreground" Value="#8a6100"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding DryRunOutput, Mode=OneWay}" IsReadOnly="True" Height="220" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="2,8"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
