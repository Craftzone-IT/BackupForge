<Window x:Class="BackupForge.Gui.NewRepoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BackupForge.Gui"
        Title="{l:Loc w_new_repo}" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <Label Content="{l:Loc w_repo_id}"/><TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"/>
        <Label Content="{l:Loc w_repo_location}"/>
        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Hint}" Tag="\\server\backup\restic   ·   sftp:user@host:/backup   ·   s3:https://…/bucket"/>
        <TextBlock Text="{l:Loc w_repo_location_help}" Style="{StaticResource Help}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{l:Loc w_next}" Click="Ok" IsDefault="True"/>
            <Button Content="{l:Loc w_cancel}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
