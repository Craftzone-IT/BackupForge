<Window x:Class="BackupForge.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BackupForge.Gui"
        Title="BackupForge" Height="760" Width="1180" MinWidth="900" MinHeight="560">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#33475b" Padding="10,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="{l:Loc l_refresh}" Command="{Binding RefreshCommand}"/>
                    <Button Content="{l:Loc l_save}" Command="{Binding SaveCommand}" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="{Binding Overview.Header}" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="#fde2e1" Padding="8,4" Visibility="{Binding ConnectionError, Converter={x:Static l:Converters.NotNullToVisible}}">
            <TextBlock Text="{Binding ConnectionError}" Foreground="#b00020" TextWrapping="Wrap"/>
        </Border>
        <Border DockPanel.Dock="Top" Background="#fff4d6" Padding="8,4" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{l:Loc l_unsaved}"/>
        </Border>
        <TabControl Margin="4">
            <!-- 1. Overview -->
            <TabItem Header="{l:Loc l_tab_overview}">
                <DockPanel>
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Overview.Warnings}" Margin="4">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#b00020" FontWeight="SemiBold"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Overview.TargetLines}" Margin="4"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Overview.Cards}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#ccd" BorderThickness="1" CornerRadius="4" Margin="6" Padding="10" Width="340">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="Gray"><Run Text="{Binding Id, Mode=OneWay}"/> · <Run Text="{Binding Type, Mode=OneWay}"/> · <Run Text="{Binding Schedule, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Text="{Binding State}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            <ProgressBar Height="6" Value="{Binding Percent, Mode=OneWay}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock><Run Text="{l:Loc l_last_run}"/>: <Run Text="{Binding LastRun, Mode=OneWay}"/> (<Run Text="{Binding Result, Mode=OneWay}"/>)</TextBlock>
                                            <TextBlock><Run Text="{l:Loc l_next_run}"/>: <Run Text="{Binding NextRun, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#444"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="{l:Loc l_run_now}" Command="{Binding RunCommand}"/>
                                                <Button Content="{l:Loc l_cancel_run}" Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                                <Button Content="{l:Loc l_approve_delete}" Command="{Binding ApproveDeleteCommand}" Visibility="{Binding GuardTripped, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- 2. Jobs -->
            <TabItem Header="{l:Loc l_tab_jobs}" DataContext="{Binding Jobs}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Width="230">
                        <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" Height="420"/>
                        <WrapPanel>
                            <Button Content="+ files" Command="{Binding AddCommand}" CommandParameter="files"/>
                            <Button Content="+ restic" Command="{Binding AddCommand}" CommandParameter="restic"/>
                            <Button Content="+ sql" Command="{Binding AddCommand}" CommandParameter="sql"/>
                            <Button Content="{l:Loc l_remove}" Command="{Binding RemoveCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}">
                        <StackPanel Margin="6">
                            <TextBlock Text="{Binding Errors}" Foreground="#b00020" TextWrapping="Wrap"/>
                            <GroupBox Header="{l:Loc l_job_basic}">
                                <UniformGrid Columns="4">
                                    <Label Content="id"/><TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Label Content="{l:Loc l_name}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Label Content="{l:Loc l_type}"/><ComboBox ItemsSource="{x:Static l:Lists.JobTypes}" SelectedItem="{Binding Type}"/>
                                    <CheckBox Content="{l:Loc l_enabled}" IsChecked="{Binding Enabled}"/><CheckBox Content="catch_up" IsChecked="{Binding CatchUp}"/>
                                </UniformGrid>
                            </GroupBox>
                            <GroupBox Header="{l:Loc l_schedule}">
                                <StackPanel>
                                    <UniformGrid Columns="4">
                                        <Label Content="kind"/><ComboBox ItemsSource="{x:Static l:Lists.ScheduleKinds}" SelectedItem="{Binding ScheduleKind}"/>
                                        <Label Content="every_min"/><TextBox Text="{Binding EveryMin, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Label Content="start (HH:mm)"/><TextBox Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Label Content="window from / to"/><StackPanel Orientation="Horizontal"><TextBox Width="60" Text="{Binding WindowFrom, UpdateSourceTrigger=PropertyChanged}" MinWidth="50"/><TextBox Width="60" Text="{Binding WindowTo, UpdateSourceTrigger=PropertyChanged}" MinWidth="50"/></StackPanel>
                                        <Label Content="times (daily)"/><TextBox Text="{Binding Times, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Label Content="days (Mon, Tue…)"/><TextBox Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Label Content="day (weekly)"/><TextBox Text="{Binding Day, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Label Content="time"/><TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Label Content="day_of_month"/><TextBox Text="{Binding DayOfMonth, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Label Content="expected_interval_h"/><TextBox Text="{Binding ExpectedIntervalH, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Label Content="on_success"/><TextBox Text="{Binding OnSuccess, UpdateSourceTrigger=PropertyChanged}"/>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding SchedulePreview}" FontStyle="Italic" Margin="4"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="{l:Loc l_sources}" Visibility="{Binding IsSql, Converter={x:Static l:Converters.InverseBoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{l:Loc l_sources_hint}" Foreground="Gray" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding Sources, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto"/>
                                    <Button Content="{l:Loc l_browse}" Command="{Binding BrowseSourceCommand}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="files" Visibility="{Binding IsFiles, Converter={StaticResource BoolToVis}}">
                                <UniformGrid Columns="4">
                                    <Label Content="target_id"/><TextBox Text="{Binding TargetId, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Label Content="subdir"/><TextBox Text="{Binding Subdir, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Label Content="mode"/><ComboBox ItemsSource="{x:Static l:Lists.Modes}" SelectedItem="{Binding Mode}"/>
                                    <Label Content="vss"/><ComboBox ItemsSource="{x:Static l:Lists.Vss}" SelectedItem="{Binding FilesVss}"/>
                                    <CheckBox Content="versioning" IsChecked="{Binding Versioning}"/><TextBox Text="{Binding VersionsFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="versioning.folder"/>
                                    <Label Content="keep_days"/><TextBox Text="{Binding KeepDays, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Label Content="delete_guard_pct"/><TextBox Text="{Binding GuardPct, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Label Content="delete_guard_min_files"/><TextBox Text="{Binding GuardMin, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Content="compare: content" IsChecked="{Binding ContentCompare}"/>
                                </UniformGrid>
                            </GroupBox>
                            <GroupBox Header="restic" Visibility="{Binding IsRestic, Converter={StaticResource BoolToVis}}">
                                <UniformGrid Columns="4">
                                    <Label Content="repo_id"/><TextBox Text="{Binding RepoId, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Label Content="vss"/><ComboBox ItemsSource="{x:Static l:Lists.Vss}" SelectedItem="{Binding ResticVss}"/>
                                    <Label Content="tags"/><TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"/>
                                </UniformGrid>
                            </GroupBox>
                            <GroupBox Header="sql" Visibility="{Binding IsSql, Converter={StaticResource BoolToVis}}">
                                <UniformGrid Columns="4">
                                    <Label Content="instance"/><TextBox Text="{Binding SqlInstance, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Content="SQL login" IsChecked="{Binding SqlAuthSql}"/><TextBox Text="{Binding SqlUsername, UpdateSourceTrigger=PropertyChanged}" ToolTip="username"/>
                                    <Label Content="{l:Loc l_password}"/><StackPanel Orientation="Horizontal"><PasswordBox x:Name="SqlPw" Width="110"/><Button Content="{l:Loc l_set}" Click="SetSqlPassword"/></StackPanel>
                                    <Label Content="databases.mode"/><ComboBox ItemsSource="{x:Static l:Lists.SqlModes}" SelectedItem="{Binding SqlMode}"/>
                                    <Label Content="include"/><TextBox Text="{Binding SqlInclude, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Label Content="exclude"/><TextBox Text="{Binding SqlExclude, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Content="include_system" IsChecked="{Binding IncludeSystem}"/><CheckBox Content="verify" IsChecked="{Binding Verify}"/>
                                    <CheckBox Content="copy_only" IsChecked="{Binding CopyOnly}"/><Label/>
                                    <Label Content="compression"/><ComboBox ItemsSource="{x:Static l:Lists.Compression}" SelectedItem="{Binding Compression}"/>
                                    <Label Content="keep_local"/><TextBox Text="{Binding KeepLocal, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Label Content="checkdb"/><TextBox Text="{Binding Checkdb, UpdateSourceTrigger=PropertyChanged}"/>
                                </UniformGrid>
                            </GroupBox>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{l:Loc l_dryrun}" Command="{Binding DataContext.DryRunCommand, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            </StackPanel>
                            <TextBox Text="{Binding DataContext.DryRunOutput, RelativeSource={RelativeSource AncestorType=TabItem}, Mode=OneWay}" IsReadOnly="True" Height="160" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- 3. Targets and repositories -->
            <TabItem Header="{l:Loc l_tab_targets}" DataContext="{Binding Targets}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="{l:Loc l_targets}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Width="200">
                                    <ListBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Id" Height="140"/>
                                    <StackPanel Orientation="Horizontal"><Button Content="+" Command="{Binding AddTargetCommand}"/><Button Content="{l:Loc l_remove}" Command="{Binding RemoveTargetCommand}"/></StackPanel>
                                </StackPanel>
                                <StackPanel DataContext="{Binding SelectedTarget}">
                                    <UniformGrid Columns="4">
                                        <Label Content="id"/><TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Label Content="type"/><ComboBox ItemsSource="{x:Static l:Lists.TargetTypes}" SelectedItem="{Binding Type}"/>
                                        <Label Content="path"/><TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Label Content="username"/><TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Label Content="min_free_gb"/><TextBox Text="{Binding MinFreeGb, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Label Content="{l:Loc l_password}"/><StackPanel Orientation="Horizontal"><PasswordBox x:Name="TargetPw" Width="110"/><Button Content="{l:Loc l_set}" Click="SetTargetPassword"/></StackPanel>
                                    </UniformGrid>
                                    <CheckBox Content="{l:Loc l_password_is_set}" IsChecked="{Binding PasswordIsSet, Mode=OneWay}" IsEnabled="False"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{l:Loc l_test_connection}" Command="{Binding DataContext.TestTargetCommand, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                        <TextBlock Text="{Binding DataContext.TestResult, RelativeSource={RelativeSource AncestorType=TabItem}}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </GroupBox>
                        <GroupBox Header="{l:Loc l_repos}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Width="200">
                                    <ListBox ItemsSource="{Binding Repos}" SelectedItem="{Binding SelectedRepo}" DisplayMemberPath="Id" Height="140"/>
                                    <StackPanel Orientation="Horizontal"><Button Content="+" Command="{Binding AddRepoCommand}"/><Button Content="{l:Loc l_remove}" Command="{Binding RemoveRepoCommand}"/></StackPanel>
                                </StackPanel>
                                <StackPanel DataContext="{Binding SelectedRepo}">
                                    <UniformGrid Columns="4">
                                        <Label Content="id"/><TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Label Content="location"/><TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Label Content="keep_last / daily"/><StackPanel Orientation="Horizontal"><TextBox Text="{Binding KeepLast}" MinWidth="40"/><TextBox Text="{Binding KeepDaily}" MinWidth="40"/></StackPanel>
                                        <Label Content="weekly / monthly / yearly"/><StackPanel Orientation="Horizontal"><TextBox Text="{Binding KeepWeekly}" MinWidth="40"/><TextBox Text="{Binding KeepMonthly}" MinWidth="40"/><TextBox Text="{Binding KeepYearly}" MinWidth="40"/></StackPanel>
                                        <Label Content="forget_prune"/><TextBox Text="{Binding ForgetPrune}"/>
                                        <Label Content="check / subset"/><StackPanel Orientation="Horizontal"><TextBox Text="{Binding Check}"/><TextBox Text="{Binding Subset}" MinWidth="40"/></StackPanel>
                                        <CheckBox Content="append_only_server" IsChecked="{Binding AppendOnly}"/>
                                        <Label Content="{l:Loc l_existing_password}"/><StackPanel Orientation="Horizontal"><PasswordBox x:Name="RepoPw" Width="110"/><Button Content="{l:Loc l_set}" Click="SetRepoPassword"/></StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding AppendOnlyHint}" TextWrapping="Wrap" Foreground="Gray"/>
                                    <CheckBox Content="{l:Loc l_password_is_set}" IsChecked="{Binding PasswordIsSet, Mode=OneWay}" IsEnabled="False"/>
                                    <Button Content="{l:Loc l_new_repo}" Command="{Binding DataContext.CreateRepoCommand, RelativeSource={RelativeSource AncestorType=TabItem}}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </DockPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4. SQL -->
            <TabItem Header="SQL" DataContext="{Binding Sql}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="{l:Loc l_discover}" Command="{Binding DiscoverCommand}"/>
                        <ComboBox ItemsSource="{Binding SqlJobIds}" SelectedItem="{Binding GrantJobId}"/>
                        <Button Content="{l:Loc l_grant}" Command="{Binding GrantCommand}"/>
                    </StackPanel>
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Problems}" Foreground="#b00020"/>
                    <TextBox DockPanel.Dock="Bottom" Text="{Binding Script, Mode=OneWay}" IsReadOnly="True" Height="140" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
                    <DataGrid ItemsSource="{Binding Databases}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="instance" Binding="{Binding Instance}"/>
                            <DataGridTextColumn Header="db" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="recovery" Binding="{Binding RecoveryModel}"/>
                            <DataGridTextColumn Header="size" Binding="{Binding Size}"/>
                            <DataGridTextColumn Header="last full (anyone)" Binding="{Binding LastFullAny}"/>
                            <DataGridTextColumn Header="" Binding="{Binding Warning}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 5. History -->
            <TabItem Header="{l:Loc l_tab_history}" DataContext="{Binding History}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding JobIds}" SelectedItem="{Binding JobFilter}" IsEditable="True"/>
                        <Button Content="{l:Loc l_refresh}" Command="{Binding LoadCommand}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding Runs}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="run" Binding="{Binding [run_id]}"/>
                                <DataGridTextColumn Header="job" Binding="{Binding [job_id]}"/>
                                <DataGridTextColumn Header="kind" Binding="{Binding [kind]}"/>
                                <DataGridTextColumn Header="trigger" Binding="{Binding [trigger]}"/>
                                <DataGridTextColumn Header="start" Binding="{Binding [start]}"/>
                                <DataGridTextColumn Header="result" Binding="{Binding [result]}"/>
                                <DataGridTextColumn Header="summary" Binding="{Binding [summary]}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"/>
                        <UniformGrid Grid.Row="2" Columns="2">
                            <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </UniformGrid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- 6. Restore -->
            <TabItem Header="{l:Loc l_tab_restore}" DataContext="{Binding Restore}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{l:Loc l_job}"/><ComboBox ItemsSource="{Binding JobIds}" SelectedItem="{Binding JobId}"/>
                            <Label Content="{l:Loc l_restore_point}"/><ComboBox ItemsSource="{Binding Points}" SelectedItem="{Binding Point}" MinWidth="220">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding [point], Mode=OneWay}"/>  <Run Text="{Binding [time], Mode=OneWay}" Foreground="Gray"/></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="↑" Command="{Binding UpCommand}"/>
                            <TextBlock Text="{Binding CurrentPath}" VerticalAlignment="Center" FontFamily="Consolas"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{l:Loc l_restore_to}"/><TextBox Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}" Width="380"/>
                            <Button Content="{l:Loc l_browse}" Command="{Binding PickTargetCommand}"/>
                            <CheckBox Content="{l:Loc l_to_original}" IsChecked="{Binding ToOriginal}"/>
                            <Button Content="{l:Loc l_restore}" Command="{Binding RestoreCommand}" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="4"/>
                    </StackPanel>
                    <DataGrid x:Name="RestoreGrid" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="RestoreGridDoubleClick">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="📁" Binding="{Binding IsDirectory}"/>
                            <DataGridTextColumn Header="name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="size" Binding="{Binding Size}"/>
                            <DataGridTextColumn Header="modified" Binding="{Binding Modified}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 7. Notifications -->
            <TabItem Header="{l:Loc l_tab_notifications}" DataContext="{Binding Notifications}">
                <StackPanel Margin="6">
                    <CheckBox Content="{l:Loc l_email_enabled}" IsChecked="{Binding Enabled}"/>
                    <UniformGrid Columns="4">
                        <Label Content="smtp_host"/><TextBox Text="{Binding Host}"/>
                        <Label Content="smtp_port"/><TextBox Text="{Binding Port}"/>
                        <Label Content="security"/><ComboBox ItemsSource="{x:Static l:Lists.Security}" SelectedItem="{Binding Security}"/>
                        <Label Content="username"/><TextBox Text="{Binding Username}"/>
                        <Label Content="{l:Loc l_password}"/><StackPanel Orientation="Horizontal"><PasswordBox x:Name="SmtpPw" Width="110"/><Button Content="{l:Loc l_set}" Click="SetSmtpPassword"/></StackPanel>
                        <Label Content="from"/><TextBox Text="{Binding From}"/>
                        <Label Content="to"/><TextBox Text="{Binding To}"/>
                        <Label Content="weekly_report"/><TextBox Text="{Binding WeeklyReport}"/>
                        <CheckBox Content="on_failure" IsChecked="{Binding OnFailure}"/><CheckBox Content="on_warning" IsChecked="{Binding OnWarning}"/>
                        <CheckBox Content="on_recovery" IsChecked="{Binding OnRecovery}"/><CheckBox Content="event_log" IsChecked="{Binding EventLog}"/>
                        <Label Content="heartbeat_url"/><TextBox Text="{Binding HeartbeatUrl}"/>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{l:Loc l_test_mail}" Command="{Binding TestCommand}"/>
                        <Button Content="{l:Loc l_report_preview}" Command="{Binding PreviewReportCommand}"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- 8. Settings -->
            <TabItem Header="{l:Loc l_tab_settings}" DataContext="{Binding Settings}">
                <StackPanel Margin="6">
                    <UniformGrid Columns="4">
                        <Label Content="instance_name"/><TextBox Text="{Binding InstanceName}"/>
                        <Label Content="language"/><ComboBox ItemsSource="{x:Static l:Lists.Languages}" SelectedItem="{Binding Language}"/>
                        <Label Content="max_parallel_jobs"/><TextBox Text="{Binding MaxParallel}"/>
                        <Label Content="history_retention_days"/><TextBox Text="{Binding HistoryDays}"/>
                        <Label Content="log_retention_days"/><TextBox Text="{Binding LogDays}"/>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{l:Loc l_export}" Command="{Binding ExportCommand}"/>
                        <Button Content="{l:Loc l_import}" Command="{Binding ImportCommand}"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
